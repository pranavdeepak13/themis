/* Themis monochrome theme: black, white and greys only. The Theme object lives in app.py. */

Screen {
    background: #000000;
    color: #fafafa;
}

Header {
    background: #0a0a0a;
    color: #fafafa;
}

Footer {
    background: #0a0a0a;
}

.hidden {
    display: none;
}

#profiles {
    height: 3;
    background: #0a0a0a;
}

#navbar {
    height: auto;
    background: #050505;
    border-top: solid #2a2a2a;
}

#nav-toggle {
    height: 1;
    text-style: bold;
}

#nav-toggle:hover {
    background: #111111;
}

#nav {
    height: 3;
}

#main {
    width: 1fr;
    height: 1fr;
}

PlaceholderPane {
    height: 100%;
}

/* Sessions pane */

SessionsPane {
    height: 100%;
}

#filters {
    height: 3;
}

.filter {
    width: 1fr;
    min-width: 12;
    background: #050505;
    border: tall #2a2a2a;
}

.filter:focus {
    border: tall #fafafa;
}

.filter.-invalid {
    border: tall #fafafa;
}

#statusbar {
    height: 1;
    padding: 0 1;
}

#status {
    width: 1fr;
    color: #7a7a7a;
}

#progress {
    width: 30;
}

#banner {
    height: 3;
    background: #0a0a0a;
    border: tall #3d3d3d;
    padding: 0 1;
}

#banner-text {
    width: 1fr;
    content-align: left middle;
    height: 100%;
    color: #fafafa;
}

#btn-archive-risk {
    min-width: 22;
}

#body {
    height: 1fr;
}

#left {
    width: 70%;
    padding-right: 1;
}

#detail {
    width: 30%;
    min-width: 40;
    border-left: solid #2a2a2a;
    padding-left: 1;
}

/* Narrow terminals: table on top, detail below */
.stacked #body {
    layout: vertical;
}

.stacked #left {
    width: 100%;
    height: 55%;
    padding-right: 0;
}

.stacked #detail {
    width: 100%;
    height: 1fr;
    border-left: none;
    border-top: solid #2a2a2a;
    padding-left: 0;
}

DataTable {
    height: 1fr;
    background: #000000;
}

DataTable > .datatable--header {
    background: #111111;
    color: #fafafa;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #fafafa;
    color: #000000;
}

#search-panel {
    height: 45%;
    border-top: solid #2a2a2a;
}

#search-status {
    height: 1;
    color: #7a7a7a;
}

#actions, #actions2 {
    height: 1;
    margin-bottom: 1;
}

#actions Button, #actions2 Button, #bulk Button {
    min-width: 8;
    margin-right: 1;
}

#bulk {
    height: 1;
    background: #111111;
    margin-bottom: 1;
}

#bulk-text {
    width: 11;
    color: #fafafa;
}

#detail-tabs {
    height: 1fr;
}

#timeline-status {
    height: 1;
    color: #7a7a7a;
}

/* Placeholder sections */

.placeholder-title {
    text-style: bold;
    color: #fafafa;
    padding: 2 4 0 4;
}

.placeholder-text {
    padding: 1 4;
    color: #7a7a7a;
}

/* Modals */

ModalScreen {
    align: center middle;
    background: #000000 60%;
}

#dialog {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 85%;
    background: #0a0a0a;
    border: thick #fafafa;
    padding: 1 2;
}

#dialog.danger {
    border: thick #fafafa;
}

#dialog-title {
    text-style: bold;
    padding-bottom: 1;
}

#dialog-body {
    height: auto;
    max-height: 22;
}

#dialog-prompt {
    padding-top: 1;
}

#dialog-buttons {
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

#dialog-buttons Button {
    margin-left: 1;
}

#resume-command {
    background: #000000;
    padding: 1 2;
    margin-bottom: 1;
}

#choices {
    height: auto;
    max-height: 16;
}

/* ---- resource sections ---- */
ResourcePane, SettingsPane, ComparePane, DoctorPane {
    height: 1fr;
    width: 1fr;
}

#r-search, #c-search {
    margin: 0 1;
}

#r-status, #s-status, #c-status, #d-status {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#r-body {
    height: 1fr;
}

#r-body > DataTable {
    width: 3fr;
    height: 1fr;
}

#r-detail {
    width: 2fr;
    height: 1fr;
    border-left: tall $primary 30%;
    padding: 0 1;
}

#r-actions {
    height: auto;
}

#r-actions Button {
    margin-right: 1;
}

#r-tabs {
    height: 1fr;
}

#c-table, #d-table {
    height: 1fr;
}

#d-detail {
    height: auto;
    max-height: 5;
    padding: 0 1;
}

#edit-area {
    height: 24;
}

#dialog.wide {
    width: 90%;
    max-width: 130;
}

/* ---- insights ---- */
InsightsPane {
    height: 1fr;
    width: 1fr;
}

#i-controls, #i-dims {
    height: auto;
    padding: 0 1;
}

.i-label {
    width: auto;
    padding: 0 1 0 0;
    color: $text-muted;
}

.i-btn {
    margin-right: 1;
}

#i-status, #i-advice-note {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#i-tabs {
    height: 1fr;
}

#i-spark {
    height: 4;
    margin: 0 1;
}

#i-summary, #i-chart, #i-context, #i-top, #i-usage {
    padding: 0 1;
}

#i-advice-body {
    height: 1fr;
}

#i-advice-body > DataTable {
    width: 3fr;
    height: 1fr;
}

#i-advice-detail {
    width: 2fr;
    height: 1fr;
    border-left: tall $primary 30%;
    padding: 0 1;
}

#i-advice-actions {
    height: auto;
}

#i-advice-actions Button {
    margin-right: 1;
}


/* ---- monochrome refinements ---- */
* {
    scrollbar-background: #000000;
    scrollbar-background-hover: #000000;
    scrollbar-background-active: #000000;
    scrollbar-color: #2a2a2a;
    scrollbar-color-hover: #3d3d3d;
    scrollbar-color-active: #7a7a7a;
    scrollbar-size-vertical: 1;
}

Header {
    text-style: bold;
    color: #fafafa;
}

Footer {
    background: #000000;
    color: #7a7a7a;
}

Footer FooterKey {
    background: #000000;
    color: #7a7a7a;
}

Footer FooterKey .footer-key--key {
    background: #000000;
    color: #fafafa;
    text-style: bold;
}

Tabs {
    background: #000000;
}

Tab {
    color: #7a7a7a;
}

Tab:hover {
    color: #fafafa;
    background: #000000;
}

Tab.-active {
    color: #fafafa;
    text-style: bold;
    background: #000000;
}

Underline > .underline--bar {
    color: #fafafa;
    background: #2a2a2a;
}

OptionList {
    background: #000000;
    border: none;
}

OptionList:focus {
    border: none;
}

Input {
    background: #0a0a0a;
    border: round #2a2a2a;
    color: #fafafa;
}

Input:focus {
    border: round #fafafa;
}

Input > .input--placeholder {
    color: #4a4a4a;
}

DataTable {
    border: none;
}

DataTable > .datatable--hover {
    background: #111111;
}

DataTable > .datatable--header {
    color: #7a7a7a;
    text-style: bold;
    background: #0a0a0a;
}

DataTable > .datatable--header-cursor, DataTable > .datatable--header-hover {
    background: #111111;
    color: #fafafa;
}

DataTable > .datatable--fixed-cursor {
    background: #fafafa;
    color: #000000;
}

TabbedContent, TabPane {
    background: #000000;
}

/* Buttons: outlined, quiet; the primary action is solid white */
Button {
    background: #000000;
    color: #fafafa;
    border: round #2a2a2a;
    border-top: round #2a2a2a;
    border-bottom: round #2a2a2a;
    text-style: none;
    height: 3;
}

Button:hover {
    background: #111111;
    border: round #7a7a7a;
}

Button:focus {
    text-style: bold;
    border: round #fafafa;
}

Button.-primary, Button.-success, Button.-warning {
    background: #fafafa;
    color: #000000;
    border: round #fafafa;
    text-style: bold;
}

Button.-primary:hover, Button.-success:hover, Button.-warning:hover {
    background: #d0d0d0;
    border: round #d0d0d0;
}

Button.-error {
    background: #000000;
    color: #fafafa;
    border: round #fafafa;
    text-style: bold;
}

Button.-error:hover {
    background: #fafafa;
    color: #000000;
}

Button.-textual-compact {
    height: 1;
    border: none;
    padding: 0 2;
    background: #111111;
    color: #fafafa;
}

Button.-textual-compact:hover {
    background: #2a2a2a;
    border: none;
}

Button.-textual-compact.-primary, Button.-textual-compact.-success, Button.-textual-compact.-warning {
    background: #fafafa;
    color: #000000;
}

Button.-textual-compact.-primary:hover, Button.-textual-compact.-success:hover {
    background: #d0d0d0;
}

Button:disabled {
    opacity: 50%;
}

Switch {
    background: #000000;
    border: round #2a2a2a;
}

Switch.-on > .switch--slider {
    color: #fafafa;
}

Checkbox, RadioButton {
    background: #000000;
}

ProgressBar Bar > .bar--bar {
    color: #fafafa;
}

ProgressBar Bar > .bar--complete {
    color: #fafafa;
}

#dialog {
    background: #050505;
    border: round #3d3d3d;
}

#dialog.danger {
    border: double #fafafa;
}

#r-detail, #i-advice-detail {
    border-left: solid #1c1c1c;
}

#detail {
    border-left: solid #1c1c1c;
}

LoadingIndicator {
    color: #fafafa;
    background: #000000;
}

Toast {
    background: #0a0a0a;
    border-left: outer #fafafa;
    color: #fafafa;
}

Toast.-warning, Toast.-error {
    border-left: outer #fafafa;
}
